<Page x:Class="SmartShift.UI.Pages.PowerSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="电源设置" Background="{DynamicResource BgPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- ====== 默认电源计划 ====== -->
            <TextBlock Text="默认电源计划" Style="{DynamicResource SectionHeader}"/>
            <TextBlock Text="无应用匹配且 CPU 负载正常时使用：" Style="{DynamicResource HintText}" Margin="0,0,0,4"/>
            <ComboBox x:Name="DefaultPlanComboBox" Width="250" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <!-- ====== 应用触发规则 ====== -->
            <TextBlock Text="应用触发规则" Style="{DynamicResource SectionHeader}"/>
            <TextBlock Text="当检测到以下程序运行时，自动切换电源计划：" Style="{DynamicResource HintText}" Margin="0,0,0,8"/>

            <DataGrid x:Name="RulesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Single" Height="200"
                      HeadersVisibility="All"
                      AllowDrop="True"
                      DragOver="RulesDataGrid_DragOver"
                      Drop="RulesDataGrid_Drop"
                      LoadingRow="RulesDataGrid_LoadingRow"
                      MouseMove="RulesDataGrid_MouseMove">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图标" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="进程名" Binding="{Binding ProcessName}" Width="*"/>
                    <DataGridTextColumn Header="运行时切换到" Binding="{Binding TargetPlanName}" Width="*"/>
                    <DataGridTextColumn Header="退出后切回" Binding="{Binding FallbackPlanName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="添加规则" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" Click="AddRule_Click"/>
                <Button Content="删除规则" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" Click="RemoveRule_Click"/>
                <Button Content="编辑规则" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" Click="EditRule_Click"/>
                <Button Content="上移" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" Click="MoveUp_Click"/>
                <Button Content="下移"
                        Style="{DynamicResource SecondaryButton}" Click="MoveDown_Click"/>
            </StackPanel>
            <TextBlock Text="提示：可拖动行调整优先级，列表顶部优先级最高；多规则匹配时按优先级生效。"
                       Style="{DynamicResource HintText}" Margin="0,6,0,0"/>

            <Separator Margin="0,16"/>

            <!-- ====== CPU 负载自动切换 ====== -->
            <TextBlock Text="CPU 负载自动切换" Style="{DynamicResource SectionHeader}"/>
            <TextBlock Text="当 CPU 使用率超过阈值并持续指定时间后，自动切换到高性能电源计划；负载恢复后自动切回。"
                       Style="{DynamicResource HintText}" Margin="0,0,0,8"/>

            <CheckBox x:Name="CpuEnabled" Content="启用 CPU 负载自动切换" Margin="0,0,0,12"
                      Checked="CpuEnabled_Changed" Unchecked="CpuEnabled_Changed"/>

            <GroupBox Header="触发条件" x:Name="CpuConfigPanel">
                <StackPanel Margin="8">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU 使用率阈值：" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ThresholdBox" Width="60" Text="80"/>
                            <TextBlock Text=" %" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="持续时间：" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SustainBox" Width="60" Text="30"/>
                            <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CurrentCpuText" Style="{DynamicResource HintText}" Margin="0,8,0,0"
                               Text="当前 CPU 使用率：--"/>
                    <TextBlock Style="{DynamicResource HintText}" Margin="0,4,0,0"
                               Text="CPU 使用率超过阈值并持续指定时间后才会触发切换，避免短暂波动导致频繁切换"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="电源计划">
                <StackPanel Margin="8">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="高负载时切换到：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="HighCpuPlanCombo" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="负载恢复后切回：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="NormalPlanCombo" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="通知">
                <StackPanel Margin="8">
                    <CheckBox x:Name="NotifyOnSwitch" Content="切换电源计划时发送通知" IsChecked="True"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Page>
