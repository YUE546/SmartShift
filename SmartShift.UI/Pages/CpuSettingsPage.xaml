<Page x:Class="SmartShift.UI.Pages.CpuSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CPU 设置" Background="{DynamicResource BgPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="CPU 负载自动切换" Style="{DynamicResource SectionHeader}"/>
            <TextBlock Text="当 CPU 使用率超过阈值并持续指定时间后，自动切换到高性能电源计划；负载恢复后自动切回。"
                       Style="{DynamicResource HintText}" Margin="0,0,0,12"/>

            <CheckBox x:Name="CpuEnabled" Content="启用 CPU 负载自动切换"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"
                      FontSize="13" Checked="CpuEnabled_Changed" Unchecked="CpuEnabled_Changed"/>

            <GroupBox Header="触发条件" Style="{DynamicResource SettingGroupBox}" x:Name="CpuConfigPanel">
                <StackPanel Margin="8">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU 使用率阈值：" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ThresholdBox" Width="60" Text="80"
                                     Style="{DynamicResource SettingTextBox}"/>
                            <TextBlock Text=" %" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="持续时间：" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SustainBox" Width="60" Text="30"
                                     Style="{DynamicResource SettingTextBox}"/>
                            <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{DynamicResource HintText}" Margin="0,4,0,0"
                               Text="CPU 使用率超过阈值并持续指定时间后才会触发切换，避免短暂波动导致频繁切换"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="电源计划" Style="{DynamicResource SettingGroupBox}">
                <StackPanel Margin="8">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="高负载时切换到：" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="HighCpuPlanCombo" Grid.Column="1"
                                  Style="{DynamicResource SettingComboBox}"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="负载恢复后切回：" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="NormalPlanCombo" Grid.Column="1"
                                  Style="{DynamicResource SettingComboBox}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="通知" Style="{DynamicResource SettingGroupBox}">
                <StackPanel Margin="8">
                    <CheckBox x:Name="NotifyOnSwitch" Content="切换电源计划时发送通知"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                              IsChecked="True"/>
                </StackPanel>
            </GroupBox>

            <!-- 实时 CPU 状态 -->
            <GroupBox Header="实时状态" Style="{DynamicResource SettingGroupBox}">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前 CPU 使用率：" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="CurrentCpuText" Text="--"
                                   Grid.Column="1" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="刷新" Width="70" Height="26"
                                Style="{DynamicResource SecondaryButton}"
                                Click="RefreshCpu_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Page>
