<Page x:Class="SmartShift.UI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="关于" Background="{DynamicResource BgPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="AppIconImage" Width="64" Height="64" Margin="0,0,0,16"/>

            <TextBlock Text="SmartShift" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="v1.0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="让 Windows 自动适应你的节奏。" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="日出日落算法："/><Run Text="NOAA Solar Calculator（离线计算）" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="主题切换："/><Run Text="注册表 + WM_SETTINGCHANGE 广播" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="电源切换："/><Run Text="powrprof.dll P/Invoke" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </TextBlock>

            <TextBlock Text="https://github.com/smartshift/SmartShift"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Cursor="Hand"
                       MouseDown="GitHubLink_Click" Margin="0,0,0,24"/>

            <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动 SmartShift"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      HorizontalAlignment="Center" Checked="AutoStartCheckBox_Checked"
                      Unchecked="AutoStartCheckBox_Unchecked"/>
        </StackPanel>
    </ScrollViewer>
</Page>
