<Page x:Class="SmartShift.UI.Pages.HotkeySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="快捷键设置" Background="{DynamicResource BgPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="全局快捷键" Style="{DynamicResource SectionHeader}"/>
            <TextBlock Text="按快捷键可随时切换主题或电源计划，无需打开设置窗口" Style="{DynamicResource HintText}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="切换浅色/深色主题：" VerticalAlignment="Center" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="ThemeHotkeyBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Height="28" Margin="0,0,0,8"
                         Text="Ctrl + Alt + T"/>
                <CheckBox x:Name="ThemeHotkeyEnabled" Grid.Row="0" Grid.Column="2" Content="启用" VerticalAlignment="Center" Margin="8,0,0,8"
                          IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="切换电源计划：" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="PowerHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Height="28"
                         Text="Ctrl + Alt + P"/>
                <CheckBox x:Name="PowerHotkeyEnabled" Grid.Row="1" Grid.Column="2" Content="启用" VerticalAlignment="Center" Margin="8,0,0,0"
                          IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>

            <TextBlock Text="修改快捷键：勾选修饰键 + 选择主键" Style="{DynamicResource HintText}" Margin="0,0,0,8"/>

            <GroupBox Header="切换主题快捷键设置">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox x:Name="ThemeCtrl" Content="Ctrl" Margin="0,0,12,0" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ThemeAlt" Content="Alt" Margin="0,0,12,0" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ThemeShift" Content="Shift" Margin="0,0,12,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ThemeWin" Content="Win"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="主键：" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="ThemeKeyCombo" Width="80" Margin="4,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="切换电源快捷键设置">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox x:Name="PowerCtrl" Content="Ctrl" Margin="0,0,12,0" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="PowerAlt" Content="Alt" Margin="0,0,12,0" IsChecked="True"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="PowerShift" Content="Shift" Margin="0,0,12,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="PowerWin" Content="Win"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="主键：" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="PowerKeyCombo" Width="80" Margin="4,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Page>
